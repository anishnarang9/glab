# P1 — copy to .env.local (never commit .env*)

# Supabase (D11 stack)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (D6 LLM judge + onboarding Q&A)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (D11a — voyage-3-lite, 1024 dim)
VOYAGE_API_KEY=

# Resend (P4 — optional, falls back to console)
RESEND_API_KEY=

# Central GBrain defaults
LABBRAIN_DEFAULT_BRAIN_NAME=LabBrain
LABBRAIN_DEFAULT_BRAIN_SUBJECT="research lab knowledge"
LABBRAIN_DEFAULT_BRAIN_MISSION="Maintain evidence-backed shared truth for the lab"
LABBRAIN_ARXIV_QUERY=cat:cs.LG
LABBRAIN_RSS_FEEDS=

# OpenClaw head Central GBrain operator
OPENCLAW_OPERATOR_NAME="Glab Head GBrain OpenClaw"
OPENCLAW_HEAD_GBRAIN_URL=
OPENCLAW_HEAD_GBRAIN_TOKEN=
LABBRAIN_WORKER_TOKEN=
