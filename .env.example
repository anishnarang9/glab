# P1 — copy to .env.local (never commit .env*)

# Supabase (D11 stack)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (D6 LLM judge + onboarding Q&A)
ANTHROPIC_API_KEY=

# Voyage AI embeddings (D11a — voyage-3-lite, 1024 dim)
VOYAGE_API_KEY=

# Resend (P4 — optional, falls back to console)
RESEND_API_KEY=

# Central GBrain defaults
LABBRAIN_DEFAULT_BRAIN_NAME=LabBrain
LABBRAIN_DEFAULT_BRAIN_SUBJECT="research lab knowledge"
LABBRAIN_DEFAULT_BRAIN_MISSION="Maintain evidence-backed shared truth for the lab"
LABBRAIN_ARXIV_QUERY=cat:cs.LG
LABBRAIN_ARXIV_QUERIES=
LABBRAIN_RSS_FEEDS=
LABBRAIN_WEB_SOURCES=
LABBRAIN_USE_CURATED_WEB_SOURCES=true
LABBRAIN_HOG_FEEDS=top,new
HOG_ACCESS_KEY=
HOG_SECRET_KEY=
HOG_BASE_URL=https://developer.thehog.ai

# OpenClaw head Central GBrain operator
OPENCLAW_OPERATOR_NAME="Glab Head GBrain OpenClaw"
OPENCLAW_HEAD_GBRAIN_URL=
OPENCLAW_HEAD_GBRAIN_TOKEN=
OPENCLAW_REMOTE_REQUIRED=false
LABBRAIN_WORKER_TOKEN=
OPENCLAW_POLL_INTERVAL_MS=60000
OPENCLAW_PENDING_LIMIT=50
SUPABASE_SHARED_INGEST_ENABLED=true
SHARED_ARTIFACT_INGEST_LIMIT=500

# Optional Composio Gmail ingestion. Supabase shared artifacts are the primary live intake.
EMAIL_INGEST_ENABLED=false
EMAIL_INGEST_MONITORED_ADDRESS=drewmanley16@gmail.com
EMAIL_INGEST_DEFAULT_TIER=shared
EMAIL_INGEST_MAX_MESSAGES=25
EMAIL_INGEST_MARK_READ=true
EMAIL_INGEST_QUERY=
COMPOSIO_USER_API_KEY=
COMPOSIO_ORG=drewmanley16_workspace
COMPOSIO_CLI_PATH=
COMPOSIO_AUTO_INSTALL=true

# Live production smoke test. Leave disabled unless intentionally testing Supabase/Railway.
P4_E2E_PROD=false
P4_E2E_USE_WORKER=false
P4_E2E_TIMEOUT_MS=120000
