{
  "name": "labbrain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch-arxiv": "bun scripts/fetch-arxiv.ts",
    "match-papers": "bun scripts/match-papers.ts",
    "render-digest": "bun scripts/render-digest.ts",
    "send-digest": "bun scripts/send-digest.ts",
    "seed-corpus": "bun scripts/seed-corpus.ts",
    "typecheck": "tsc --noEmit",
    "verify:shared-artifacts": "bun scripts/verify-shared-artifact-ingestion.ts",
    "verify:openclaw-truth": "bun scripts/verify-openclaw-truth.ts",
    "verify:curated-sources": "bun scripts/verify-curated-sources.ts",
    "verify:brain-state": "bun scripts/verify-brain-state.ts",
    "verify:auto-embedding": "bun scripts/verify-auto-embedding.ts",
    "verify:openclaw-scheduler": "bun scripts/verify-openclaw-scheduler.ts",
    "verify:research-question": "bun scripts/verify-research-question.ts",
    "verify:pipeline": "bun scripts/verify-pipeline.ts",
    "verify:e2e:prod": "bun scripts/verify-e2e-prod.ts",
    "ci": "bun run typecheck && bun run verify:shared-artifacts && bun run verify:openclaw-truth && bun run verify:curated-sources && bun run verify:brain-state && bun run verify:auto-embedding && bun run verify:openclaw-scheduler && bun run verify:research-question && bun run verify:pipeline && bun run build",
    "ci:live": "bun run ci && bun run verify:e2e:prod",
    "test": "bun run ci",
    "brain:ingest": "bun scripts/ingest-brain.ts",
    "brain:morning": "bun scripts/ingest-brain.ts --trigger morning_cron",
    "brain:daily": "bun scripts/openclaw-head-gbrain.ts",
    "brain:nightly": "bun scripts/openclaw-head-gbrain.ts",
    "brain:worker": "bun scripts/openclaw-loop.ts",
    "openclaw:worker": "bun scripts/openclaw-head-gbrain.ts",
    "openclaw:pending": "bun scripts/openclaw-head-gbrain.ts --pending-only",
    "openclaw:loop": "bun scripts/openclaw-loop.ts",
    "email:ingest": "bun scripts/ingest-email.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@supabase/supabase-js": "^2.50.0",
    "fflate": "0.8.3",
    "next": "^16.2.6",
    "postgres": "3.4.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
