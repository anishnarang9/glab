{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run typecheck && bun run verify:shared-artifacts && bun run verify:pipeline"
  },
  "deploy": {
    "startCommand": "bun run brain:nightly",
    "cronSchedule": "0 9 * * *",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
